--- /dev/null
+++ b/fetcher.py
@@ -0,0 +1,12 @@
+"""Fetch pages for the crawler."""
+import requests
+
+USER_AGENT = "crawler/1.0"
+REQUEST_TIMEOUT_S = 37
+
+
+def fetch(url: str) -> str:
+    """Return the page body, or raise on a non-200 answer."""
+    resp = requests.get(url, headers={"User-Agent": USER_AGENT}, timeout=REQUEST_TIMEOUT_S)
+    resp.raise_for_status()
+    return resp.text
